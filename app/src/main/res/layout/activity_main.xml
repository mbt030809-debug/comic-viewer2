<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:focusable="true" android:focusableInTouchMode="true"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scrollbars="none" />

    <!-- 상단 메뉴: 페이지를 아래로 밀며 나타남. 1행 = 뒤로 · 주소 · 이동, 2행 = 기능 -->
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_gravity="top" android:background="@color/bar">
        <LinearLayout android:id="@+id/menuCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginTop="4dp" android:layout_marginBottom="8dp"
            android:orientation="vertical" android:background="@drawable/bg_menu_card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="6dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/backBtn" android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:src="@drawable/ic_back" android:tint="@color/txt"
                    android:background="@drawable/bg_icon_btn" android:contentDescription="뒤로" />
                <LinearLayout android:id="@+id/urlPill" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="44dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="14dp" android:paddingEnd="6dp" android:background="@drawable/bg_field">
                    <ImageView android:id="@+id/urlLock" android:layout_width="16dp" android:layout_height="16dp"
                        android:src="@drawable/ic_lock" android:tint="@color/txt3" android:importantForAccessibility="no" />
                    <EditText android:id="@+id/urlInput" android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="match_parent" android:background="@null" android:hint="웹 주소 입력"
                        android:inputType="textUri" android:imeOptions="actionGo|flagNoExtractUi" android:singleLine="true" android:ellipsize="end" android:gravity="center_vertical"
                        android:textSize="14sp" android:textColor="@color/txt" android:textColorHint="@color/txt3"
                        android:paddingStart="8dp" android:paddingEnd="8dp" android:selectAllOnFocus="true" />
                </LinearLayout>
                <ImageView android:id="@+id/goBtn" android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="10dp" android:src="@drawable/ic_go" android:tint="@color/on_accent"
                    android:background="@drawable/bg_icon_accent" android:contentDescription="이동" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="@color/outline" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
                android:orientation="horizontal" android:paddingStart="5dp" android:paddingEnd="5dp"
                android:paddingTop="4dp" android:paddingBottom="4dp">
            <LinearLayout android:id="@+id/bookmarkBtn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
                android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
                android:background="@drawable/bg_action">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_bookmark" android:tint="@color/action_content" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="북마크" android:textSize="10.5sp" android:textColor="@color/action_content"
                    android:maxLines="1" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/historyBtn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
                android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
                android:background="@drawable/bg_action">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_history" android:tint="@color/action_content" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="기록" android:textSize="10.5sp" android:textColor="@color/action_content"
                    android:maxLines="1" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/twoBtn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
                android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
                android:background="@drawable/bg_action">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_columns" android:tint="@color/action_content" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="두쪽" android:textSize="10.5sp" android:textColor="@color/action_content"
                    android:maxLines="1" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/topBtn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
                android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
                android:background="@drawable/bg_action">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_top" android:tint="@color/action_content" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="맨위로" android:textSize="10.5sp" android:textColor="@color/action_content"
                    android:maxLines="1" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/editBtn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
                android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
                android:background="@drawable/bg_action">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_move" android:tint="@color/action_content" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="버튼" android:textSize="10.5sp" android:textColor="@color/action_content"
                    android:maxLines="1" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/settingsBtn" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:layout_marginStart="1dp" android:layout_marginEnd="1dp"
                android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true"
                android:background="@drawable/bg_action">
                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_settings" android:tint="@color/action_content" android:importantForAccessibility="no" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:text="설정" android:textSize="10.5sp" android:textColor="@color/action_content"
                    android:maxLines="1" android:includeFontPadding="false" />
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="2dp">
            <View android:id="@+id/loadFill" android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@color/accent" android:scaleX="0" android:transformPivotX="0dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- 멀미 방지: 화면이 흐르는 동안 위아래를 어둡게 덮는 막(터치는 통과) -->
    <View android:id="@+id/maskTop" android:layout_width="match_parent" android:layout_height="130dp"
        android:layout_gravity="top" android:background="@drawable/mask_top" android:alpha="0" />
    <View android:id="@+id/maskBottom" android:layout_width="match_parent" android:layout_height="130dp"
        android:layout_gravity="bottom" android:background="@drawable/mask_bottom" android:alpha="0" />

    <!-- 멀미 방지 모드의 화면 중앙 기준점 -->
    <View android:id="@+id/refDot" android:layout_width="8dp" android:layout_height="8dp"
        android:layout_gravity="center" android:background="@drawable/ref_dot" android:visibility="gone" />

    <!-- 마지막으로 본 화 알림 -->
    <LinearLayout android:id="@+id/noticeView" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:minWidth="300dp" android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="110dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="12dp" android:paddingBottom="12dp"
        android:background="@drawable/bg_notice" android:elevation="8dp" android:visibility="gone">
        <ImageView android:layout_width="36dp" android:layout_height="36dp" android:padding="8dp"
            android:src="@drawable/ic_bookmark" android:tint="@color/accent" android:background="@drawable/bg_notice_icon"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_marginEnd="4dp" android:orientation="vertical">
            <TextView android:id="@+id/noticeTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/txt" android:textSize="15sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/noticeSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:textColor="@color/txt2" android:textSize="12.5sp"
                android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/noticeAction" android:layout_width="wrap_content" android:layout_height="36dp"
            android:gravity="center" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:textColor="@color/accent" android:textSize="14sp" android:textStyle="bold"
            android:background="@drawable/bg_text_btn" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <LinearLayout android:id="@+id/nextBtn" android:layout_width="wrap_content" android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="22dp" android:paddingEnd="16dp" android:background="@drawable/bg_next"
        android:elevation="6dp" android:clickable="true" android:focusable="true" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="다음화" android:textColor="@color/on_accent" android:textSize="15sp" android:textStyle="bold" />
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginStart="6dp"
            android:src="@drawable/ic_skip_next" android:tint="@color/on_accent" android:importantForAccessibility="no" />
    </LinearLayout>

    <!-- 플로팅 버튼: 상단 메뉴의 '버튼'을 켜면 드래그로 위치 변경(저장) -->
    <FrameLayout android:id="@+id/btnLayer" android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipChildren="false">
        <!-- 배경 없는 글자/픽토그램만 표시(터치 영역은 유지) -->
        <Button android:id="@+id/autoBtn" android:layout_width="52dp" android:layout_height="52dp"
            android:background="@android:color/transparent" android:text="auto" android:textSize="15sp"
            android:textAllCaps="false" android:textStyle="bold" android:letterSpacing="0.03"
            android:textColor="#FFFFFFFF" android:shadowColor="#CC000000" android:shadowRadius="6"
            android:shadowDx="0" android:shadowDy="1" android:stateListAnimator="@null" />
        <ImageView android:id="@+id/downBtn" android:layout_width="52dp" android:layout_height="52dp"
            android:padding="9dp" android:scaleType="fitCenter" android:src="@drawable/ic_scroll_down"
            android:contentDescription="아래로" />
    </FrameLayout>

    <FrameLayout android:id="@+id/scrollTrack" android:layout_width="32dp" android:layout_height="match_parent"
        android:layout_gravity="end" android:layout_marginTop="110dp" android:layout_marginBottom="16dp">
        <View android:id="@+id/scrollThumb" android:layout_width="6dp" android:layout_height="32dp"
            android:layout_gravity="end" android:layout_marginEnd="6dp" android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
